[Unit]
Description=Workbench Update Agent (host-side docker compose pull/up)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
# 按服务器实际路径修改：
#   WorkingDirectory / UPDATE_CONTROL_DIR / COMPOSE_DIR / EnvironmentFile
WorkingDirectory=/opt/workbench
Environment=UPDATE_CONTROL_DIR=/opt/workbench/update-control
Environment=COMPOSE_DIR=/opt/workbench
Environment=COMPOSE_FILE=compose.ghcr.yaml
Environment=COMPOSE_SERVICE=app
Environment=UPDATE_POLL_SECONDS=2
EnvironmentFile=-/opt/workbench/update-agent.env
ExecStart=/usr/bin/python3 /opt/workbench/deploy/update-agent/agent.py
Restart=always
RestartSec=3
# 不需要给工作台容器挂 docker.sock；本单元以宿主机用户运行 docker。
User=root

[Install]
WantedBy=multi-user.target
