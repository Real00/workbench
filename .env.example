WORKBENCH_PORT=8080
WORKBENCH_ADMIN_USERNAME=admin
WORKBENCH_ADMIN_PASSWORD=replace-with-a-strong-password
WORKBENCH_JWT_SECRET=replace-with-at-least-32-random-characters!
# Fernet key: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WORKBENCH_ENCRYPTION_KEY=replace-with-a-fernet-key
# Optional. Defaults to <repo>/data/uploads
# WORKBENCH_UPLOAD_DIR=/var/lib/workbench/uploads
# 跨源放行来源（逗号分隔）：桌面端 Tauri 壳或独立网页域名访问云端 API 时配置
# WORKBENCH_CORS_ORIGINS=https://workbench.example.com,tauri://localhost

# --- GHCR 部署一键更新（可选）---
# 与宿主机 Update Agent 共享；未配置时设置页只能查看版本、不能点更新
# WORKBENCH_UPDATE_AGENT_TOKEN=replace-with-a-long-random-shared-secret
# WORKBENCH_UPDATE_CONTROL_DIR=/app/data/update-control
# WORKBENCH_UPDATE_GITHUB_REPO=real00/workbench
# WORKBENCH_UPDATE_GITHUB_REF=main
# 私有仓检查服务器/桌面更新、代理下载 DMG 需要有 contents:read 的 PAT（或 classic repo 读权限）
# WORKBENCH_UPDATE_GITHUB_TOKEN=
